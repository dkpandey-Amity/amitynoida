<?xml version="1.0" encoding="utf-8"?>

<configuration>

  <system.web>
    <compilation debug="false" />
    <httpRuntime enableVersionHeader="false" />
  </system.web>

  <system.webServer>

    <!-- ==================================================
         HANDLERS
    =================================================== -->
    <handlers>

      <remove name="WebDAV" />

      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />

      <remove name="OPTIONSVerbHandler" />

      <remove name="TRACEVerbHandler" />

      <!-- Keep original working handler -->
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />

    </handlers>


    <!-- ==================================================
         SECURITY HEADERS
    =================================================== -->
    <httpProtocol>

      <customHeaders>

        <remove name="X-Powered-By" />

        <add name="X-Content-Type-Options" value="nosniff" />

        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />

        <!--<add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self';" />-->

      </customHeaders>

    </httpProtocol>


    <!-- ==================================================
         CUSTOM 404 PAGE
    =================================================== -->
    <httpErrors errorMode="Custom" existingResponse="Replace">

      <remove statusCode="404" subStatusCode="-1" />

      <error statusCode="404" path="404.html" responseMode="File" />

    </httpErrors>


    <!-- ==================================================
         URL REWRITE
    =================================================== -->
    <rewrite>

      <rewriteMaps configSource="RedirectMap.config" />

      <rules>


        <!-- ==================================================
             HTTPS REDIRECT
        =================================================== -->
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">

          <match url="(.*)" />

          <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />

          </conditions>

          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="true" redirectType="Permanent" />

        </rule>

        <!-- ==================================================
     REDIRECT /home TO ROOT
================================================== -->
        <rule name="Redirect Home to Root" stopProcessing="true">

          <match url="^home/?$" ignoreCase="true" />

          <action type="Redirect" url="/" appendQueryString="false" redirectType="Permanent" />

        </rule>


        <!-- ==================================================
             SKIP CHILD IIS APPLICATIONS
        =================================================== -->
        <rule name="Skip Child Apps" stopProcessing="true">

          <match url="^(careerplanningsession|alumni|webinars|varanasiopenhouse2026|asnrsd|amity-temple-dual-degree|amity-temple|studyabroad)(/.*)?$" />

          <action type="None" />

        </rule>


        <!-- ==================================================
             REMOVE TRAILING SLASH
        =================================================== -->
        <rule name="Remove Trailing Slash" stopProcessing="true">

          <match url="(.*)/$" />

          <conditions logicalGrouping="MatchAll">

            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />

          </conditions>

          <action type="Redirect" url="/{R:1}" appendQueryString="true" redirectType="Permanent" />

        </rule>


        <!-- ==================================================
             COURSE REDIRECT
        =================================================== -->
        <rule name="Course Redirect" stopProcessing="true">

          <match url="^(.+)$" />

          <conditions>

            <add input="{CourseRedirects:{R:1}}" pattern="(.+)" />

          </conditions>

          <action type="Redirect" url="/{C:1}" redirectType="Permanent" />

        </rule>


        <!-- ==================================================
             SPECIAL PROGRAM REDIRECT
        =================================================== -->
        <rule name="Special Program Redirect" stopProcessing="true">

          <match url="(.*)" />

          <conditions>

            <add input="{SpecialProgramRedirects:{R:1}}" pattern="(.+)" />

          </conditions>

          <action type="Redirect" url="/{C:1}" redirectType="Permanent" />

        </rule>


        <!-- ==================================================
             INVALID SPECIAL PROGRAM
        =================================================== -->
        <rule name="Invalid Special Program URL" stopProcessing="true">

          <match url="^([a-zA-Z0-9\-]+)/([a-zA-Z0-9\-]+)$" />

          <conditions logicalGrouping="MatchAll">

            <add input="{SpecialPrograms:{R:0}}" pattern="1" negate="true" />

            <add input="{R:1}" pattern="^(ug|pg|phd)$" negate="true" />

            <add input="{R:1}" pattern="^(faculty|events)$" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             INVALID COURSE
        =================================================== -->
        <rule name="Invalid Course URL" stopProcessing="true">

          <match url="^(ug|pg|phd)/([^/]+)/([^/]+)$" />

          <conditions>

            <add input="{ValidCourses:{R:0}}" pattern="1" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             INVALID DISCIPLINE
        =================================================== -->
        <rule name="Invalid Discipline URL" stopProcessing="true">

          <match url="^(ug|pg|phd)/([^/]+)$" />

          <conditions>

            <add input="{ValidDisciplines:{R:0}}" pattern="1" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             INVALID FACULTY
        =================================================== -->
        <rule name="Invalid Faculty URL" stopProcessing="true">

          <match url="^faculty/(.*)$" />

          <conditions>

            <add input="{ValidFaculty:{R:0}}" pattern="1" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             INVALID EVENT
        =================================================== -->
        <rule name="Invalid Event URL" stopProcessing="true">

          <match url="^events/(.*)$" />

          <conditions>

            <add input="{ValidEvents:{R:0}}" pattern="1" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             INVALID CMS URL
        =================================================== -->
        <rule name="Invalid Static URL" stopProcessing="true">

          <match url="^([a-zA-Z0-9\-]+)$" />

          <conditions logicalGrouping="MatchAll">

            <add input="{R:1}" pattern="^admission-career-test$" negate="true" />

            <add input="{ValidUrls:{R:1}}" pattern="1" negate="true" />

            <add input="{CourseRedirects:{R:1}}" pattern="(.+)" negate="true" />

            <add input="{SpecialProgramRedirects:{R:1}}" pattern="(.+)" negate="true" />

          </conditions>

          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page Not Found" />

        </rule>


        <!-- ==================================================
             ANGULAR ROUTES
        =================================================== -->
        <rule name="Angular Routes" stopProcessing="true">

          <match url=".*" />

          <conditions logicalGrouping="MatchAll">

            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />

            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />

            <add input="{URL}" pattern="^/(api|blog|services|swagger|admission-2026|careerplanningsession|alumni|webinars|varanasiopenhouse2026|asnrsd|amity-temple-dual-degree|amity-temple|studyabroad)" negate="true" />

          </conditions>

          <!-- Keep your original working Angular rewrite -->
          <action type="Rewrite" url="/" />

        </rule>


      </rules>

    </rewrite>

  </system.webServer>

</configuration>
