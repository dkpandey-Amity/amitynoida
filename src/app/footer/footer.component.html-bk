<!-- <div class="enquiry-now-btn">
    <img src="assets/img/enquiry-now.png" alt="Enquiry Now" data-bs-toggle="modal" data-bs-target="#enquiryNow">
</div> -->

<div class="progress-wrap">
    <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
        <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
    </svg>
</div>

<!-- The Enqyuiry Modal -->
<div class="modal fade" id="enquiryNow">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Enquire Now</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form [formGroup]="contactForm" (ngSubmit)="onSubmit()" class="contact-form ajax-contact">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="text" class="form-control style-white" formControlName="Name"
                                    placeholder="Name*" />
                                <i class="fal fa-user"></i>
                                <div *ngIf="contactForm.get('Name')?.touched && contactForm.get('Name')?.invalid">
                                    <b><small class="text-danger"
                                            *ngIf="contactForm.get('Name')?.errors?.['required']">Name is
                                            required.</small></b>
                                    <b><small class="text-danger"
                                            *ngIf="contactForm.get('Name')?.errors?.['minlength']">Name must be at least
                                            2
                                            characters long.</small></b>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="email" class="form-control style-white" formControlName="Email"
                                    placeholder="Email*" />
                                <i class="fal fa-envelope"></i>
                                <div *ngIf="contactForm.get('Email')?.touched && contactForm.get('Email')?.invalid">
                                    <b><small class="text-danger"
                                            *ngIf="contactForm.get('Email')?.errors?.['required']">Email is
                                            required.</small></b>
                                    <b><small class="text-danger"
                                            *ngIf="contactForm.get('Email')?.errors?.['email']">Enter
                                            a valid email.</small></b>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12" style="margin-bottom: 10px;">
                            <div>
                                <div class="form-group" style="display: flex; margin-bottom: 0px;">
                                    <select formControlName="scountrycode" class="form-control style-white"
                                        style="width: 100px; margin-right: 10px; padding-right: 0px;">
                                        <!-- <option value="">Country Code</option> -->
                                        <option *ngFor="let item of countryCodes;" [value]="item.phone_code">
                                            {{ item.country_name }} +{{ item.phone_code }}
                                        </option>
                                    </select>

                                    <input type="tel" class="form-control style-white" formControlName="Phone"
                                        placeholder="Mobile*" />
                                    <i class="fal fa-phone"></i>
                                </div>
                                <div *ngIf="contactForm.get('Phone')?.touched && contactForm.get('Phone')?.invalid">
                                    <b>
                                        <small class="text-danger"
                                            *ngIf="contactForm.get('Phone')?.errors?.['required']">
                                            Phone number is required.
                                        </small>
                                    </b>
                                    <b>
                                        <small class="text-danger"
                                            *ngIf="contactForm.get('Phone')?.errors?.['pattern']">
                                            Enter a valid 10-digit phone number.
                                        </small>
                                    </b>
                                </div>
                            </div>
                        </div>


                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="ug-program-radio">
                                    <input class="form-check-input" type="radio" id="ug-program" formControlName="stype"
                                        value="G" (change)="onProgramTypeChange($event, 'G')"
                                        [checked]="selectedProgramType === 'G'" />
                                    <label class="form-check-label" for="ug-program">UG Program</label>
                                </div>

                                <div class="ug-program-radio">
                                    <input class="form-check-input" type="radio" id="pg-program" formControlName="stype"
                                        value="PG" (change)="onProgramTypeChange($event, 'PG')"
                                        [checked]="selectedProgramType === 'PG'" />
                                    <label class="form-check-label" for="pg-program">PG Program</label>
                                </div>

                                <div *ngIf="contactForm.get('stype')?.touched && contactForm.get('stype')?.invalid">
                                    <b><small class="text-danger"
                                            *ngIf="contactForm.get('stype')?.errors?.['required']">Please select a
                                            Program Type.</small></b>
                                </div>
                            </div>
                        </div>


                        <div class="col-md-12">
                            <div class="form-group">
                                <select class="form-control" formControlName="scoursecode" id="programSelect">
                                    <option value="">Select Program*</option> <!-- Default option -->
                                    <option *ngFor="let item of displayedPrograms" [value]="item.value">
                                        {{ item.sfullname || 'Unnamed Program' }}
                                    </option>
                                </select>
                                <div
                                    *ngIf="contactForm.get('scoursecode')?.touched && contactForm.get('scoursecode')?.invalid">
                                    <b>
                                        <small class="text-danger"
                                            *ngIf="contactForm.get('scoursecode')?.errors?.['required']">
                                            Please select a Program.
                                        </small>
                                    </b>
                                </div>
                            </div>
                        </div>


                        <div class="form-btn col-12 mt-10">
                            <button type="submit" class="th-btn">
                                Send Message<i class="fas fa-long-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>